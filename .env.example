# Copy this file to .env.local and use values from one Supabase environment.
# The service-role key is server-only and must never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only organizer access settings. Use a secret of at least 32 characters.
ORGANIZER_PIN=
ORGANIZER_COOKIE_SECRET=
